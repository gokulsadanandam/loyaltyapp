# Production values for scripts/push-secrets.sh.
# Copy to .env.deploy (gitignored via .env*), fill in, run the script, then delete .env.deploy.
# Next.js never loads this file, so local builds and tests keep using .env.local.

# --- Supabase (cloud project) ----------------------------------------------
# Dashboard URL: supabase.com/dashboard/project/<ref>
SUPABASE_PROJECT_REF=
# Account → Access Tokens (read-only scopes; see DEPLOYMENT.md)
SUPABASE_ACCESS_TOKEN=
# Project Settings → Database (letters and digits only avoids URL-encoding issues)
SUPABASE_DB_PASSWORD=
# Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Vercel -------------------------------------------------------------------
# Account Settings → Tokens. Org and project IDs are read from .vercel/project.json.
VERCEL_TOKEN=

# --- App ----------------------------------------------------------------------
# Production origin, no trailing slash (Vercel → Project → Settings → Domains)
PRODUCTION_URL=https://loyalty-web.vercel.app
# Resend → API Keys, and a sender on a domain verified in Resend.
# Optional: leave blank to keep notification emails off (they still appear in-app).
RESEND_API_KEY=
EMAIL_FROM="Your Shop <hello@yourdomain.com>"

# Leave blank to generate strong random values (written back here on first run).
CRON_SECRET=
QR_HMAC_SECRET=
