# Copy to .env.local. `npx supabase status` prints the local values.

# --- Public (shipped to the browser) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...) or legacy anon JWT. Safe to expose: RLS is the boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical app origin. Used to build auth email links; must be in Supabase's redirect allow-list.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Server only (NEVER prefix with NEXT_PUBLIC_) --------------------------
# Secret key (sb_secret_...) or legacy service_role JWT. Bypasses RLS.
# Used ONLY by the notification delivery worker (/api/notifications/deliver).
SUPABASE_SECRET_KEY=
# Shared secret for the delivery cron (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
# Email: Resend in production; Mailpit's HTTP API locally. One must be set.
EMAIL_FROM=Loyalty Demo Store <noreply@loyalty.test>
MAILPIT_URL=http://127.0.0.1:54324
# RESEND_API_KEY=

# --- Edge Function secrets (set with `supabase secrets set`, not here, in prod) ---
# RAZORPAY_WEBHOOK_SECRET=
# QR_HMAC_SECRET=
